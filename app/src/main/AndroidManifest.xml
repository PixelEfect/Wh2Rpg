<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- ⬇️ DODAJ TO: -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ikonka"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Wh2Rpg"

        tools:targetApi="35"
        android:requestLegacyExternalStorage="true">

        <activity
            android:name=".views.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".views.HomeActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:label="@string/app_name"/>
        <activity
            android:name=".views.ProfileActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.card.CardsListActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.card.StatsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.card.InventoryActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.card.BackstoryActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".views.card.SkillsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".views.create.UnfinishedCardsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.create.NewCardAncestryActivity"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.create.NewCardAttributesActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.create.NewCardBackstoryActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.create.NewCardProfessionsActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.create.NewCardSkillsAndAbilitiesActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.card.ProfessionActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.LoginActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.ProfessionsConsistencyChecker"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.BlessingViewerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.SpellViewerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
        <activity
            android:name=".views.MutationViewerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"/>
    </application>

</manifest>